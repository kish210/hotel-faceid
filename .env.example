# ---------------------------------------------------------------- database
# Default: a local SQLite file — no database server to install or run.
DATABASE_URL=sqlite:///./data/hotel_faceid.db
# For a shared/high-volume install point this at an existing PostgreSQL server
# and load db/init/001_schema.sql into it once:
# DATABASE_URL=postgresql+psycopg://hotel:secret@192.168.1.10:5432/hotel_faceid

# ------------------------------------------------------------------ server
# The API also serves the built web panel, so this is the only port users need.
API_HOST=0.0.0.0
API_PORT=8000
# Built panel. Empty = the web/dist folder inside this installation.
WEB_DIST=

# -------------------------------------------------------------------- auth
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-32-byte-hex-string
JWT_EXPIRE_MINUTES=480

# Fernet key used to encrypt camera passwords at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# ------------------------------------------------------------------- media
MEDIA_ROOT=./data/media
# Raw face crops are purged after this many days (privacy retention policy).
FACE_IMAGE_RETENTION_DAYS=30

# ------------------------------------------------------- recognition tuning
# Cosine similarity above which two faces are considered the same person.
FACE_MATCH_THRESHOLD=0.42
# Minimum detector confidence to consider a detection at all.
FACE_DETECT_THRESHOLD=0.6
# Minimum face box width in pixels — smaller faces are too low-quality.
MIN_FACE_SIZE=60
# Ignore repeated detections of the same person within this many seconds.
EVENT_DEBOUNCE_SECONDS=60
# Process 1 out of every N frames (lower = more CPU/GPU).
FRAME_SAMPLE_RATE=5
# 'CPUExecutionProvider' or 'CUDAExecutionProvider'
ONNX_PROVIDER=CPUExecutionProvider

# Estimate male/female (and age) with the InsightFace genderage model.
GENDER_DETECTION=true
# Crops scoring below this quality report no gender instead of guessing.
GENDER_MIN_QUALITY=0.35

# Folder holding a models/<pack> directory. Empty means: use the models next
# to the installation if present, otherwise download to the user profile.
MODEL_ROOT=

# ----------------------------------------------------- analytics modules
# Run the per-camera image-processing modules (fight, intrusion, plates…).
ANALYTICS_ENABLED=true
# Analytics looks at one frame out of every N the recogniser samples.
ANALYTICS_FRAME_DIVISOR=3
# Where downloaded module packs are stored.
MODULE_ROOT=./data/modules

# ------------------------------------------------------------------- stays
# A person absent for longer than this is considered checked out.
STAY_TIMEOUT_HOURS=12
# Local timezone used for night-boundary calculation.
HOTEL_TIMEZONE=Asia/Tehran

# ------------------------------------------------------------ face-service
# Empty means "the API on this machine, on API_PORT". Set it only when the
# API runs on a different computer.
API_BASE_URL=
# Shared secret the face-service uses to authenticate against the API.
SERVICE_API_KEY=change-me-service-key
# Where the API reaches face-service for photo-based guest search.
FACE_SERVICE_URL=http://localhost:8001

# -------------------------------------------------- automatic email report
# Leave SMTP_* empty to disable the scheduled report email.
EMAIL_REPORT_ENABLED=false
# Hour of the day (hotel timezone) at which yesterday's report is sent.
EMAIL_REPORT_HOUR=8
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=report@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=Hotel Face-ID <report@example.com>
# Comma-separated list of recipients.
REPORT_EMAIL_TO=manager@example.com
